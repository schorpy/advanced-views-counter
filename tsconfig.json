{
    "include": ["vite.admin.config.js", "vite.frontend.config.js", "resources/js/**/*"],
    "compilerOptions": {
      "allowJs": true,
      "baseUrl": ".",
      "paths": {
        "@/*": [
          "./resources/js/admin/*"
        ]
      },
      "checkJs": true,
      "declaration": true,
      "esModuleInterop": true,
      "jsx": "react-jsx",
      "module": "ES2022",
      "moduleResolution": "Node",
      "noEmit": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "sourceMap": true,
      "strict": true,
      "target": "ES2020"
    }
  }
  